# The deployed backend's base API URL (no trailing slash, include /api).
# Vite only exposes env vars prefixed VITE_ to client code -- see
# src/lib/api.js. Leave unset for local dev (defaults to
# http://localhost:5000/api, matching backend/.env's default PORT).
VITE_API_BASE=https://your-backend-host.example.com/api
